# Vega Bulut — ortam ayarları. Bu dosyayı deploy/.env olarak kopyalayıp düzenleyin.

# Panelin alan adı (DNS A kaydı bu VPS'i göstermeli) ve Let's Encrypt bildirim e-postası
ALAN_ADI=panel.firmaniz.com
EPOSTA=bilgi@firmaniz.com
PUBLIC_URL=https://panel.firmaniz.com

# İlk açılışta oluşturulacak sistem yöneticisi (sonra panelden şifreyi değiştirin)
ADMIN_USER=yonetici
ADMIN_PASSWORD=buraya-uzun-ve-guclu-bir-sifre

# Yeni firmalara varsayılan yıllık TÜFE (%) — reel büyüme hesabı için; boş = firma ayarından
VARSAYILAN_ENFLASYON=

# TCMB döviz kurları (döviz kasa/banka TL karşılığı): 1 = açık
TCMB_KURLARI=1

# Yönetim panelinden demo verisi yüklemeye izin (canlıda kapalı tutun)
DEMO_IZINLI=0

# Köprü istek gövdesi üst sınırı (MB) ve günlük düzeyi (debug|info|warn|error)
KOPRU_MAX_MB=64
LOG_LEVEL=info
