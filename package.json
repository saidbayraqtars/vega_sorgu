{
  "name": "vega-sorgu-desktop",
  "version": "2.0.0",
  "description": "Vega Köprü — müşteri sunucusundaki Arctos/Vega (VEGADB) verisini salt-okunur okuyup 15 dakikada bir Vega Bulut'a eşitleyen Windows tepsi uygulaması (Electron, otomatik güncellemeli).",
  "main": "electron/main.js",
  "author": "Said Bayraktar",
  "repository": {
    "type": "git",
    "url": "https://github.com/saidbayraqtars/vega_sorgu.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "node scripts/release.js",
    "test": "npm --prefix cloud test && node --test \"bridge/test/lock.test.js\""
  },
  "build": {
    "appId": "com.vega.sorgu",
    "productName": "Vega Köprü",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saidbayraqtars",
        "repo": "vega_sorgu",
        "releaseType": "release"
      }
    ],
    "files": [
      "package.json",
      "electron/**",
      "bridge/package.json",
      "bridge/src/**",
      "bridge/sql/**",
      "shared/**",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vega Köprü",
      "artifactName": "VegaKopru-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mssql": "^11.0.2"
  }
}
